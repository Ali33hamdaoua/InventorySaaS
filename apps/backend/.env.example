# ---------------------------------------------------------------------------
# Backend — apps/backend
# Copy to .env for local dev. In production these are set on Render.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Aiven PostgreSQL requires TLS; keep sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# --- Auth -----------------------------------------------------------------
# Generate each with: openssl rand -base64 48
JWT_SECRET="change-me"
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES_IN=7d

# --- HTTP -----------------------------------------------------------------
PORT=3001
API_PREFIX=api
NODE_ENV=development

# Comma-separated, no trailing slash. Must list the exact frontend origin(s).
CORS_ORIGIN="http://localhost:5173"

SWAGGER_ENABLED=true
SWAGGER_PATH=docs

THROTTLE_TTL=60
THROTTLE_LIMIT=120

# --- Branding -------------------------------------------------------------
# Used by the Excel/PDF exports and the Swagger title. Read at runtime, so a
# Render restart is enough — no rebuild needed.
BRAND_NAME="Hong Kong Sushi"
APP_NAME="Inventory SaaS"
BRAND_PRIMARY_COLOR="#D72638"

# --- Currency / locale ----------------------------------------------------
# Symbol is appended manually ("1 234,00 DH"); Intl cannot render MAD as "DH".
# Keep in sync with the VITE_CURRENCY_* vars on the frontend.
CURRENCY_SYMBOL="DH"
CURRENCY_CODE="MAD"
LOCALE="fr-MA"

# --- Puppeteer ------------------------------------------------------------
# Only needed when the bundled Chromium is not used (e.g. Alpine images).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
