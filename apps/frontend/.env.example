# ---------------------------------------------------------------------------
# Frontend — apps/frontend
# Copy to .env for local dev. In production these are set on Vercel.
#
# IMPORTANT: Vite inlines these at BUILD time. Editing a variable on Vercel
# has no effect until you redeploy.
# ---------------------------------------------------------------------------

# Must include the /api prefix — lib/api.ts uses this value as-is.
VITE_API_URL=http://localhost:3001/api

# --- Branding -------------------------------------------------------------
VITE_BRAND_NAME="Hong Kong Sushi"
VITE_BRAND_SUBTITLE="Inventaire & food cost — Agadir"

# Path under apps/frontend/public/ (also used as the favicon).
VITE_BRAND_LOGO="/logo.png"

# "light" or "dark".
VITE_BRAND_THEME="light"

# --- Palette --------------------------------------------------------------
# Plain hex. src/lib/brand.ts converts them to the HSL triplets that Tailwind
# reads via hsl(var(--token)), and derives the remaining surface shades.
#
# The same values are duplicated as literals in src/index.css so the first
# paint is already correct — keep the two in sync.
VITE_COLOR_PRIMARY="#D72638"      # rouge laque (boutons, liens, accents)
VITE_COLOR_BG="#F5F1EA"           # fond de page (ton riz)
VITE_COLOR_CARD="#FFFFFF"         # fond de carte
VITE_COLOR_TEXT="#1A1A1D"         # texte
VITE_COLOR_TEXT_MUTED="#6E6862"   # texte atténué
VITE_COLOR_BORDER="#E3DCD1"       # bordures
